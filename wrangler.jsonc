{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-finance",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "assets": {
    "directory": "dist/family-finance-worker/browser",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/operations",
      "/plan",
      "/accounts",
      "/dashboards",
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "workers_dev": true,
  "preview_urls": false
}
