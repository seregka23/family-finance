{
  "name": "family-finance",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "install:ci": "npm ci",
    "dev": "ng serve --host 0.0.0.0",
    "build": "npm run build:node && npm run build:worker",
    "start": "node --env-file-if-exists=.env.local dist/family-finance/server/server.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && ng test --watch=false",
    "test:unit": "node --test tests/*model.test.mjs tests/*api.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "build:node": "ng build",
    "build:worker": "ng build --configuration production,worker",
    "deploy": "npm run build:worker && wrangler deploy",
    "preview": "npm run build:worker && wrangler dev",
    "cf:typegen": "wrangler types",
    "deploy:check": "wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:execute:local": "wrangler d1 execute DB --local",
    "db:execute:remote": "wrangler d1 execute DB --remote",
    "prebuild:node": "npm run cf:typegen",
    "prebuild:worker": "npm run cf:typegen",
    "pretypecheck": "npm run cf:typegen",
    "predev": "npm run cf:typegen",
    "auth:setup:local": "node scripts/setup-local-auth.mjs",
    "auth:invite": "node scripts/create-invite.mjs"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "jsdom": "^30.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "4.159.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "@oxc-parser/binding-wasm32-wasi@0.156.0": {
      "@emnapi/core": "2.0.0-beta.3",
      "@emnapi/runtime": "2.0.0-beta.3"
    }
  }
}
